# MCP AkTools Configuration Template
# Copy this file to .env and customize the values as needed

# ============================================================================
# Server Configuration
# ============================================================================

# Transport mode: stdio (default) or http
# TRANSPORT=stdio

# HTTP server host (only used when TRANSPORT=http)
# HOST=0.0.0.0

# HTTP server port (only used when TRANSPORT=http)
# PORT=80


# ============================================================================
# API Configuration
# ============================================================================

# NewsNow API base URL (optional, for global financial news)
# NEWSNOW_BASE_URL=

# NewsNow channels (comma-separated list)
# NEWSNOW_CHANNELS=wallstreetcn-quick,cls-telegraph,jin10


# ============================================================================
# Cache Configuration
# ============================================================================

# Memory cache TTL in seconds (default: 600 = 10 minutes)
# CACHE_MEMORY_TTL=600

# Disk cache TTL in seconds (default: 1200 = 20 minutes)
# CACHE_DISK_TTL=1200

# Maximum number of items in memory cache (default: 100)
# CACHE_MAX_SIZE=100


# ============================================================================
# SQLite Database Cache Configuration
# ============================================================================

# SQLite database file path for persistent cache storage
# If not set, defaults to user's cache directory:
#   - Windows: %LOCALAPPDATA%\mcp-aktools\cache.db
#   - macOS: ~/Library/Caches/mcp-aktools/cache.db
#   - Linux: ~/.cache/mcp-aktools/cache.db
# Recommended: Use project data directory for better organization
# Example: ./data/stock_data.db
DATABASE_URL=./data/stock_data.db


# ============================================================================
# Logging Configuration
# ============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# LOG_LEVEL=INFO

# Log format string
# LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Log file path (optional, logs to console if not set)
# Example: /var/log/mcp-aktools/app.log or ./logs/app.log
# LOG_FILE=

# Maximum size of log file in bytes before rotation (default: 10MB)
# LOG_FILE_MAX_BYTES=10485760

# Number of backup log files to keep (default: 5)
# LOG_FILE_BACKUP_COUNT=5


# ============================================================================
# Rate Limiting Configuration
# ============================================================================

# Number of API calls allowed per time period
# RATE_LIMIT_CALLS=10

# Time period for rate limiting in seconds
# RATE_LIMIT_PERIOD=1


# ============================================================================
# Retry Configuration
# ============================================================================

# Maximum number of retry attempts for failed API calls
# RETRY_MAX_ATTEMPTS=3

# Exponential backoff factor (delay = backoff_factor * (2 ^ attempt))
# RETRY_BACKOFF_FACTOR=2.0

# Maximum delay between retries in seconds
# RETRY_MAX_DELAY=60


# ============================================================================
# Trading Rules Configuration
# ============================================================================

# Path to trading rules file (optional)
# This file will be used as the highest priority reference when analyzing
# trends and buy/sell points. Supports both absolute and relative paths.
# Example: /path/to/trading_rules.md or ./trading_rules.md
# TRADING_RULE_FILE=
